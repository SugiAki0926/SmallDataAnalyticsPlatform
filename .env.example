# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=15432
POSTGRES_USER=dap
POSTGRES_PASSWORD=replace-me-with-your-password

# --- Source DB: Ingestion ---
SOURCE_DB=source
SOURCE_DB_USER=worker_source_ingestion
SOURCE_DB_PASSWORD=replace-me-with-your-password

# --- Analytics DB ---
ANALYTICS_DB=analytics

# --- dlt: Source DB + Analytics raw DB ---
DLT_DB_USER=worker_dlt
DLT_DB_PASSWORD=replace-me-with-your-password

# --- dbt: Analytics DB ---
DBT_DB_USER=worker_dbt
DBT_DB_PASSWORD=replace-me-with-your-password

# --- Airflow: metadata DB ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=worker_airflow
AIRFLOW_DB_PASSWORD=replace-me-with-your-password
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://worker_airflow:replace-me-with-your-password@postgres:5432/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=replace-me-with-fernet-key
AIRFLOW__API_AUTH__JWT_SECRET=replace-me-with-jwt-secret-key
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
# opt/SmallDataAnalyticsPlatform/secrets/airflow_ui_passwords.json に {"<AIRFLOW_UI_USER>":"<password>"} を置く必要がある
AIRFLOW_UI_USER=admin

# --- OpenWeather（API） ---
OPENWEATHER_API_KEY=replace-me-with-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_CITY_ID=1857910
OPENWEATHER_CITY_QUERY=Kyoto
OPENWEATHER_FORECAST_CNT=8

# --- Docker: All containers ---
TZ=Asia/Tokyo

# --- Docker network for elt()---
DAP_DOCKER_NETWORK=dap-dev

# --- dbt target for elt()---
DBT_TARGET=dev
