# PostgreSQL は物理1コンテナ。役割はデータベース名で分ける。

# --- PostgreSQL（スーパーユーザー。compose.dev.yml の初期化用） ---
# Dev Container / compose 内のアプリは POSTGRES_HOST + POSTGRES_PORT（5432）で接続する。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=15432
POSTGRES_USER=dap
POSTGRES_PASSWORD=password

# --- Source DB（基幹相当）: ingestion 用 ---
SOURCE_DB=source
SOURCE_DB_USER=worker_source_ingestion
SOURCE_DB_PASSWORD=password

# --- Analytics DB（DWH相当） ---
ANALYTICS_DB=analytics

# dlt: Source 読取 + Analytics raw 書込（同じロールで2つのDBに接続）
DLT_DB_USER=worker_dlt
DLT_DB_PASSWORD=password

# dbt: Analytics のみ
DBT_DB_USER=worker_dbt
DBT_DB_PASSWORD=password

# --- Airflow metadata DB ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=worker_airflow
AIRFLOW_DB_PASSWORD=password
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://worker_airflow:password@postgres:5432/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=replace-me-with-fernet-key
AIRFLOW__API_AUTH__JWT_SECRET=dap-dev-jwt-secret-change-me
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/

# --- OpenWeather（API） ---
OPENWEATHER_API_KEY=********************
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_CITY_ID=1857910
OPENWEATHER_CITY_QUERY=Kyoto
# 5 day / 3 hour forecast の件数（未指定時は 8 = 24時間分）。最大 40。
OPENWEATHER_FORECAST_CNT=8

# --- Docker（全コンテナ共通） ---
TZ=Asia/Tokyo

# --- Docker network（Mac: dap-dev / Pi: dap-prod） ---
DAP_DOCKER_NETWORK=dap-dev

# --- dbt target（compose.dev.yml は dev。compose.prod.yml では prod） ---
DBT_TARGET=dev
