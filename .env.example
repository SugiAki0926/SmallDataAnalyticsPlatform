# PostgreSQL は物理1コンテナ。役割はデータベース名で分ける。

# --- PostgreSQL（1コンテナ共通） ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dap
POSTGRES_PASSWORD=password

# --- Source DB（基幹相当） ---
SOURCE_DB=source
SOURCE_DB_USER=dap
SOURCE_DB_PASSWORD=password

# --- Analytics DB（DWH相当） ---
ANALYTICS_DB=analytics
ANALYTICS_DB_USER=dap
ANALYTICS_DB_PASSWORD=password

# --- Airflow metadata DB（Metadata DB） ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=dap
AIRFLOW_DB_PASSWORD=password
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dap:password@postgres:5432/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=password-replace-with-fernet-key

# --- OpenWeather（API） ---
OPENWEATHER_API_KEY=password
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# 例: Tokyo。複数都市はカンマ区切りにする想定。
OPENWEATHER_CITY_IDS=1850147

# --- Docker network（Mac: dap-dev / Pi: dap-prod） ---
DAP_DOCKER_NETWORK=dap-dev
